{
	"Format": "Project",
	"Version": 1,
	"Name": "Validation",
	"StartScene": "Assets/Scenes/Main.scene",
	"Window": {
		"Title": "Game",
		"Width": 1600,
		"Height": 900,
		"VSync": true,
		"Fullscreen": false,
		"Resizable": true
	},
	"Simulation": {
		"FixedHz": 60,
		"MaxStepsPerFrame": 5,
		"Seed": 0,
		"MaxEntities": 65536
	},
	"Physics": {
		"Gravity": [0, -9.81, 0],
		"Layers": ["Default"],
		"Collisions": [
			["Default", "Default"]
		]
	},
	"Input": {
		"Actions": {
			"Attack": {
				"Type": "Button",
				"Bindings": ["Gamepad.RightTrigger", "Gamepad.LeftX", "Key.Nope"],
				"Positive": [],
				"Negative": [],
				"Gamepad": "",
				"Invert": false
			}
		}
	},
	"Rendering": {
		"ShadowMapSize": 2048,
		"SsaoHalfResolution": false
	},
	"Scripting": {
		"MemoryLimitMB": 256,
		"CallbackBudgetMs": 1000,
		"PauseOnError": true,
		"BlockPlayOnTypeErrors": false
	},
	"Export": {
		"BuildScenes": ["Assets/Scenes/Main.scene"],
		"Exclude": ["Assets/Tests/**"],
		"Icon": "",
		"Version": "1.0.0",
		"Company": "",
		"PruneUnreferenced": false
	},
	"Testing": {
		"Suites": [],
		"Replays": [],
		"CaseTimeoutTicks": 600,
		"SuiteTickLimit": 36000,
		"CoverageGates": false
	},
	"SortingLayers": {
		"Layers": ["Default"]
	},
	"Physics2D": {
		"Gravity": [0, -9.81]
	},
	"Localization": {
		"Locale": ""
	},
	"Ui": {
		"Navigation": true,
		"Submit": ["Key.Enter", "Key.Space", "Gamepad.South"],
		"Cancel": ["Key.Escape", "Gamepad.East"],
		"Up": ["Key.Up", "Gamepad.DPadUp"],
		"Down": ["Key.Down", "Gamepad.DPadDown"],
		"Left": ["Key.Left", "Gamepad.DPadLeft"],
		"Right": ["Key.Right", "Gamepad.DPadRight"],
		"Next": ["Key.Tab"],
		"StickNavigation": true
	}
}
