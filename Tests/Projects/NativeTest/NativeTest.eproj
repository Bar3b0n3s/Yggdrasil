			}
		}
	},
	"Rendering": {
		"ShadowMapSize": 2048,
		"SsaoHalfResolution": false
	},
	"Scripting": {
		"MemoryLimitMB": 256,
		"CallbackBudgetMs": 1000,
		"PauseOnError": true,
		"BlockPlayOnTypeErrors": false
	},
	"Export": {
		"BuildScenes": ["Assets/Scenes/Main.scene"],
		"Exclude": ["Assets/Tests/**"],
