				"Clock": [],
				"Overrides": {
					"CallbackBudgetMs": 0,
					"MemoryLimitMB": 0,
					"PauseOnError": "Inherit"
				},
				"ExpectQuit": -1,
				"Modes": ["Editor", "Release", "Dist"]
			},
			{
