		"Title": "Rolling Ball",
		"Width": 1280,
		"Height": 720,
		"VSync": true,
		"Fullscreen": false,
		"Resizable": false
	},
	"Simulation": {
		"FixedHz": 60,
		"MaxStepsPerFrame": 5,
		"Seed": 27,
