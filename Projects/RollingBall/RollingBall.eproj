			["Ball", "Trigger"]
		]
	},
	"Input": {
		"Actions": {
			"MoveX": {
				"Type": "Axis",
				"Bindings": [],
				"Positive": ["Key.D", "Key.Right"],
				"Negative": ["Key.A", "Key.Left"],
				"Gamepad": "Gamepad.LeftX",
				"Invert": false
			},
			"MoveZ": {
				"Type": "Axis",
				"Bindings": [],
				"Positive": ["Key.W", "Key.Up"],
				"Negative": ["Key.S", "Key.Down"],
				"Gamepad": "Gamepad.LeftY",
				"Invert": false
			},
			"Restart": {
				"Type": "Button",
				"Bindings": ["Key.R", "Gamepad.Start"],
				"Positive": [],
				"Negative": [],
