{"method": "script.write", "params": {"path": "Assets/Scripts/GraphMembers/Health.luau", "source": "--!strict\n-- The health of GraphMembers.scene's Crystal (M39, Docs/Decisions/0056-m39-graphs-behaviours.md decision 12; World Tree's\n-- brief 18): Damage(hit) asks every other behaviour of its entity Blocks(hit) and, when none blocks the hit, takes its\n-- Amount and calls Damaged(hit) on each behaviour that has it, as the game's Health does. The Rune graph beside it answers\n-- both through its graph methods.\nexport type Health = ScriptInstance & {\n\tMaxHealth: number,\n\tHealth: number,\n}\n\nlocal Health = {}\n\nHealth.Fields = {\n\tMaxHealth = Field.Number(10),\n}\n\nfunction Health.OnStart(self: Health)\n\tself.Health = self.MaxHealth\nend\n\n-- Whether a behaviour of the entity blocked `hit`.\nfunction Health.Damage(self: Health, hit: any): boolean\n\tfor _, behaviour in self.Entity:GetScripts() do\n\t\t-- The cast drops the checker's nil refinement of the member, under which it cannot be called.\n\t\tif not rawequal(behaviour, self) and behaviour.Blocks ~= nil and (behaviour :: any):Blocks(hit) then\n\t\t\treturn true\n\t\tend\n\tend\n\tself.Health -= hit.Amount\n\tfor _, behaviour in self.Entity:GetScripts() do\n\t\tif not rawequal(behaviour, self) and behaviour.Damaged ~= nil then\n\t\t\t(behaviour :: any):Damaged(hit)\n\t\tend\n\tend\n\treturn false\nend\n\nreturn Script.Define(\"Health\", Health)\n"}}
{"method": "script.write", "params": {"path": "Assets/Scripts/GraphMembers/Press.luau", "source": "--!strict\n-- The press of GraphMembers.scene (M39, Docs/Decisions/0056-m39-graphs-behaviours.md decision 12; brief 18's SteamValve): a\n-- Luau behaviour whose Running field the Valve graph writes, whose Toggle method the graph calls with its own instance, and\n-- whose returned table's Pressure the graph reads. It counts every fixed update in Ticks (it holds while the world is\n-- paused) and its strokes while it runs.\nexport type Press = ScriptInstance & {\n\tRunning: boolean,\n\tSpeed: number,\n\tTicks: number,\n\tStrokes: number,\n\tBy: any,\n}\n\nlocal Press = {}\n\nPress.Fields = {\n\tRunning = Field.Bool(true),\n\tSpeed = Field.Number(2),\n}\n\nfunction Press.OnCreate(self: Press)\n\tself.Ticks = 0\n\tself.Strokes = 0\n\tself.By = nil\nend\n\nfunction Press.OnFixedUpdate(self: Press)\n\tself.Ticks += 1\n\tif self.Running then\n\t\tself.Strokes += 1\n\tend\nend\n\n-- Records who toggled the press and returns its pressure, a table.\nfunction Press.Toggle(self: Press, by: any): { Pressure: number }\n\tself.By = by\n\treturn { Pressure = self.Speed * 10 }\nend\n\nreturn Script.Define(\"Press\", Press)\n"}}
{"method": "script.write", "params": {"path": "Assets/Scripts/GraphMembers/Bubbles.luau", "source": "--!strict\n-- The menu of GraphMembers.scene (M39, Docs/Decisions/0056-m39-graphs-behaviours.md decision 12): it counts the clicks that\n-- bubble up from its buttons, whose Clicker graphs consume a click with Return.OnUiClick of true (Consuming) or let it\n-- bubble with false (Bubbling, whose slot sets the graph's Consume field false).\nexport type Bubbles = ScriptInstance & {\n\tHeard: number,\n}\n\nlocal Bubbles = {}\n\nfunction Bubbles.OnCreate(self: Bubbles)\n\tself.Heard = 0\nend\n\nfunction Bubbles.OnUiClick(self: Bubbles, element: Entity): boolean?\n\tself.Heard += 1\n\treturn nil\nend\n\nreturn Script.Define(\"Bubbles\", Bubbles)\n"}}
{"method": "script.write", "params": {"path": "Assets/Scripts/GraphMembers/Striker.luau", "source": "--!strict\n-- Strikes GraphMembers.scene's Crystal from input (Assets/Tests/Replays/GraphMembers.replay; M39,\n-- Docs/Decisions/0056-m39-graphs-behaviours.md decision 12): each Jump deals a Bolt of 2 through the Crystal's Health,\n-- which calls the Rune graph's Damaged method, and the Rune moves the Crystal to x = Blows, so the replay's state hash\n-- depends on its input. Without input nothing strikes.\nlocal Striker = {}\n\nfunction Striker.OnFixedUpdate(self: ScriptInstance)\n\tif Input.IsActionPressed(\"Jump\") then\n\t\tlocal health = self.Entity:GetScript(\"Health\")\n\t\tif health ~= nil then\n\t\t\thealth:Damage({ Kind = \"Bolt\", Amount = 2 })\n\t\tend\n\tend\nend\n\nreturn Script.Define(\"Striker\", Striker)\n"}}
