			"Luau": "local p = Scene.FindByName(\"Pilot\")\nlocal s = p:GetScripts()\nreturn #s == 2 and s[1] == p:GetScript(\"Mover\") and s[2] == p:GetScript(\"Trail\") and p.Transform.Translation.x > 1"
