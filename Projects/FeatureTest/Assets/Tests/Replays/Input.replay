		{
			"Tick": 3,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(3).SpacePressed and p:Step(3).SpaceDown and p:Step(3).JumpPressed and p:Frame(3).SpacePressed"
		},
		{
			"Tick": 5,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(4).SpaceReleased and not p:Step(4).SpaceDown and p:Frame(4).SpaceReleased and p:Step(5).DDown and p:Step(5).MoveX == 1"
		},
		{
			"Tick": 9,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(7).MousePosition == vector.create(320, 180, 0) and p:Step(9).MoveX == 0 and not p:Step(9).DDown"
		},
		{
			"Tick": 9,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(8).LeftPressed and p:Step(8).FirePressed and p:Step(8).MousePosition == vector.create(330, 190, 0) and p:Frame(8).LeftPressed"
		},
		{
			"Tick": 11,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(10).LeftReleased and p:Step(10).FireReleased and p:Step(11).MouseDelta == vector.create(5, -3, 0) and p:Frame(11).MouseDelta == vector.create(5, -3, 0) and p:Step(12) == nil"
		},
		{
			"Tick": 14,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(12).Scroll == vector.create(0, 2, 0) and p:Step(13).Scroll == vector.create(-1, 0.5, 0) and p:Step(14).Scroll == vector.zero and p:Frame(12).Scroll == vector.create(0, 2, 0)"
		},
		{
			"Tick": 15,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(14).SouthDown and p:Step(14).JumpPressed and p:Step(14).PadConnected and not p:Step(15).SouthDown"
		},
		{
			"Tick": 17,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(15).LeftY == 0.75 and math.abs(p:Step(15).MoveY + 0.6 / 0.85) < 1e-6 and p:Step(16).LeftX == -0.5 and math.abs(p:Step(16).MoveX + 0.35 / 0.85) < 1e-6 and p:Step(17).RightTrigger == 1"
		},
		{
			"Tick": 19,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(19).LeftX == 0 and p:Step(19).LeftY == 0 and p:Step(19).MoveX == 0 and p:Step(19).MoveY == 0 and p:Step(19).RightTrigger == 0"
		},
		{
			"Tick": 25,
			"Luau": "local p = Scene.FindByName(\"InputProbe\"):GetScript()\nreturn p:Step(21).JumpPressed and p:Step(22).JumpReleased and math.abs(p:Step(22).MoveX - 0.4) < 1e-6 and p:Step(23).FirePressed and p:Step(24).FireReleased and p:Step(25).MoveX == 0"
		},
