	"Expect": [
		{
			"Tick": 10,
			"Luau": "return not Scene.FindByPath(\"/Walker/Character\").Animator.Playing"
		},
		{
			"Tick": 80,
			"Luau": "local character = Scene.FindByPath(\"/Walker/Character\")\nlocal position = Scene.FindByPath(\"/Walker/Character/Pack\").Transform.WorldPosition\nreturn character.Animator.Playing and vector.magnitude(character.Transform.Translation) > 0.2 and position.x > 2.2"
		},
		{
			"Tick": 120,
			"Luau": "local sword = Scene.FindByPath(\"/Waver/Armature/Sword\")\nlocal attachment = sword.BoneAttachment\nlocal position, rotation = Scene.FindByPath(\"/Waver/Armature\").Animator:GetJointTransform(\"Joint0\")\nlocal director = Scene.FindByName(\"Director\"):GetScript()\nreturn director.Folds == 1 and attachment.Bone == \"Joint0\"\n\tand vector.magnitude(sword.Transform.WorldPosition - (position + rotation * attachment.Offset)) < 0.001"
		}
	],
