		{
			"Tick": 900,
			"Luau": "local buggy = Scene.FindByPath(\"/Buggy\")\nlocal driver = buggy:GetScript(\"VehicleDriver\")\nreturn math.abs(buggy.WheeledVehicle:GetSpeed()) < 1 and driver.TopSpeed > 10 and driver.DrivenTicks > 500"
		}
