		{
			"Tick": 40,
			"Luau": "local link = Scene.FindByPath(\"/Chain/Link3\")\nreturn Scene.FindByName(\"Machines\"):GetScript().Strikes == 1 and vector.magnitude(link.RigidBody:GetLinearVelocity()) > 0.5"
		},
		{
			"Tick": 150,
			"Luau": "local door = Scene.FindByPath(\"/TrapDoor\").HingeJoint\nreturn door:GetAngle() < -40 and Scene.FindByPath(\"/Crate\").Transform.WorldPosition.y < 1.5"
		},
		{
			"Tick": 320,
			"Luau": "return math.abs(Scene.FindByPath(\"/TrapDoor\").HingeJoint:GetAngle()) < 2"
		},
		{
			"Tick": 360,
			"Luau": "local plank = Scene.FindByPath(\"/Plank\")\nlocal watcher = plank:GetScript()\nreturn watcher.Breaks == 1 and plank.FixedJoint.Broken"
