	"Expect": [
		{
			"Tick": 599,
			"Luau": "local warden = Scene.FindByName(\"Warden\").Transform.Translation\nlocal function insideLava(point: vector): boolean\n\treturn math.abs(point.x + 3) < 7 and math.abs(point.z + 5) < 1\nend\nfor _, name in { \"Husk1\", \"Husk2\", \"Husk3\", \"Husk4\", \"Brute\" } do\n\tlocal chaser = Scene.FindByName(name)\n\tlocal state = chaser:GetScript(\"NavChaser\")\n\tlocal position = chaser.Transform.Translation\n\tif state.Plans < 30 or state.Complete < 1 or insideLava(position) or vector.magnitude(position - warden) > 3 then\n\t\treturn false\n\tend\nend\nreturn warden.x < 1 and warden.z < -3"
		}
	],
