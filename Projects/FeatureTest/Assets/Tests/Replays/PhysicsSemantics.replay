		{
			"Tick": 90,
			"Luau": "local p = Scene.FindByName(\"BrickB\"):GetScript()\nlocal e = p.Events[1]\nreturn #p.Events == 1 and e.Kind == \"CollisionEnter\" and e.Other == \"DropBall\" and e.Collider == \"BrickB\" and e.OtherCollider == \"DropBall\""
		},
		{
			"Tick": 160,
			"Luau": "local p = Scene.FindByName(\"BrickB\"):GetScript()\nfor _, e in p.Events do\n\tif e.Kind == \"CollisionEnter\" and e.Other == \"Pebble\" and e.Collider == \"BrickB\" and e.OtherCollider == \"Pebble\" and e.Tick > 100 then return true end\nend\nreturn false"
		},
		{
			"Tick": 160,
			"Luau": "local d = Scene.FindByName(\"Pebble\"):GetScript()\nreturn d.Presses == 1 and d.Dropped"
		},
		{
			"Tick": 260,
			"Luau": "local p = Scene.FindByName(\"BrickB\"):GetScript()\nfor _, e in p.Events do\n\tif e.Kind == \"CollisionExit\" and e.Other == \"Pebble\" and e.Tick >= 200 then return true end\nend\nreturn false"
		},
		{
			"Tick": 260,
			"Luau": "local g = Scene.FindByName(\"Glider\")\nreturn #g:GetScript().Events == 0 and #Scene.FindByName(\"GlideBrick\"):GetScript().Events == 0"
		}
