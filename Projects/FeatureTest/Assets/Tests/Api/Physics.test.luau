--!strict
-- The Physics module (§9.5, §11.5): ray, sphere and overlap queries with hit identities, layer masks, body and collider
-- bounds and the session's gravity, which starts at the project's [0, -10, 0].
local Support = require("./Support")

return Test.Suite("Api.Physics", function()
	Test.Case("rays and sweeps find the crate on the ground with its identity and distance", function()
		Test.WaitTicks(1) -- bodies appear at the first step's PreStep
		local crate = Support.Find("Crate")
		local ground = Support.Find("Ground")
		local origin, down = vector.create(0, 5, 0), vector.create(0, -1, 0)
		local hit = Physics.Raycast(origin, down, 20)
		Test.Expect(hit ~= nil, "the ray hits")
		local first = hit :: RaycastHit
		Test.ExpectEqual(first.Entity, crate)
		Test.ExpectEqual(first.Body, crate)
		Test.ExpectNear(first.Distance, 4, 0.01, "the crate's top is at 1 m")
		Test.ExpectNear(first.Point, vector.create(0, 1, 0), 0.01)
		Test.ExpectNear(first.Normal, vector.create(0, 1, 0), 0.001)
		local all = Physics.RaycastAll(origin, down, 20)
		Test.ExpectEqual(#all, 2, "the crate and the ground")
		Test.ExpectEqual(all[1].Entity, crate)
		Test.ExpectEqual(all[2].Entity, ground)
		Test.Expect(all[1].Distance < all[2].Distance, "sorted by distance")
		local sweep = Physics.SphereCast(origin, 0.25, down, 20)
		Test.Expect(sweep ~= nil and (sweep :: RaycastHit).Entity == crate, "the sweep hits the crate")
		Test.Expect((sweep :: RaycastHit).Distance < first.Distance, "a sphere touches earlier than a ray")
		Test.ExpectEqual(Physics.Raycast(origin, vector.create(0, 1, 0), 20), nil, "nothing above")
	end)

	Test.Case("layer masks select what queries see", function()
		local origin, down = vector.create(0, 5, 0), vector.create(0, -1, 0)
		local default = Physics.LayerMask("Default")
		Test.Expect(default ~= 0, "Default has a bit")
		Test.ExpectEqual(Physics.LayerMask(), 0)
		Test.ExpectEqual(Physics.LayerMask("Default", "Ball"), bit32.bor(default, Physics.LayerMask("Ball")))
		Test.Expect(Physics.Raycast(origin, down, 20, default) ~= nil, "the Default layer is hit")
		Test.ExpectEqual(Physics.Raycast(origin, down, 20, Physics.LayerMask("Debris")), nil, "nothing on Debris")
		Test.ExpectEqual(#Physics.RaycastAll(origin, down, 20, 0), 0)
		Test.Expect(not pcall(Physics.LayerMask, "Undeclared"), "an unknown layer is an error")
	end)

	Test.Case("overlaps list colliders in UUID order", function()
		local crate = Support.Find("Crate")
		local around = Physics.OverlapSphere(vector.create(0, 0.5, 0), 0.6)
		Test.Expect(table.find(around, crate) ~= nil, "the crate overlaps its own centre")
		local box = Physics.OverlapBox(vector.create(0, 0, 0), vector.create(0.6, 0.6, 0.6), Quat.Identity())
		Test.Expect(#box >= 2, "the crate and the ground")
		for index = 2, #box do
			Test.Expect(box[index - 1].ID < box[index].ID, "sorted by UUID")
		end
		Test.ExpectEqual(#Physics.OverlapBox(vector.create(0, 50, 0), vector.one), 0, "nothing high above")
		Test.ExpectEqual(#Physics.OverlapSphere(vector.create(0, 0.5, 0), 0.6, Physics.LayerMask("Debris")), 0)
	end)

	Test.Case("body and collider bounds follow the shapes", function()
		local crate = Support.Find("Crate")
		local minimum, maximum = Physics.GetBodyBounds(crate)
		Test.ExpectNear(minimum :: vector, vector.create(-0.5, 0, -0.5), 0.01)
		Test.ExpectNear(maximum :: vector, vector.create(0.5, 1, 0.5), 0.01)
		local colliderMinimum, colliderMaximum = Physics.GetColliderBounds(crate)
		Test.ExpectNear(colliderMinimum :: vector, minimum :: vector, 0.0001)
		Test.ExpectNear(colliderMaximum :: vector, maximum :: vector, 0.0001)
		local empty = Scene.CreateEntity("NoBody")
		local none, nothing = Physics.GetBodyBounds(empty)
		Test.ExpectEqual(none, nil)
		Test.ExpectEqual(nothing, nil)
		Test.ExpectEqual((Physics.GetColliderBounds(empty)), nil)
	end)

	Test.Case("gravity starts at the project setting and a script can change it", function()
		Test.ExpectEqual(Physics.GetGravity(), vector.create(0, -10, 0))
		Physics.SetGravity(vector.create(0, -5, 0))
		Test.ExpectEqual(Physics.GetGravity(), vector.create(0, -5, 0))
		local ball = Support.Find("Ball").RigidBody :: RigidBody
		local before = ball:GetLinearVelocity().y
		Test.WaitTicks(4)
		Test.ExpectNear(ball:GetLinearVelocity().y - before, -5 * 4 / 64, 0.01, "the ball falls at the new gravity")
		Test.Expect(not pcall(Physics.SetGravity, vector.create(0, math.huge, 0)), "infinite gravity is refused")
	end)
end)
