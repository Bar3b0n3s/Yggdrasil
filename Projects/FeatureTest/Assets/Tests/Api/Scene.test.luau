--!strict
-- The Scene module (§5.7, §11.5, §11.6): creation, searches in canonical order, the primary camera, prefab instances,
-- deferred destruction and Scene.Load of the running scene (the SceneLoad suite covers loading another scene).
local Support = require("./Support")

return Test.Suite("Api.Scene", function()
	Test.Case("the scene reports its name, parameters, count and primary camera", function()
		Test.ExpectEqual(Scene.GetName(), "Scripting")
		local parameters = Scene.GetLoadParameters()
		Test.ExpectEqual(next(parameters), nil, "the suite passes no parameters")
		Test.ExpectEqual(Scene.GetPrimaryCamera(), Support.Find("Camera"))
		Test.Expect(Scene.GetEntityCount() > 10, "Scripting.scene's entities")
	end)

	Test.Case("created entities are found by id, name, path, tag and component in canonical order", function()
		local count = Scene.GetEntityCount()
		local root = Scene.CreateEntity("SearchRoot")
		local a = Scene.CreateEntity("Twin", root)
		local b = Scene.CreateEntity("Twin", root)
		local unnamed = Scene.CreateEntity()
		Test.ExpectEqual(unnamed.Name, "Entity", "the default name")
		Test.ExpectEqual(Scene.GetEntityCount(), count + 4)
		a:AddTag("Searched")
		b:AddTag("Searched")
		Test.ExpectEqual(Scene.FindByID(b.ID), b)
		Test.ExpectEqual(Scene.FindByID("0000000000000000"), nil)
		Test.ExpectEqual(Scene.FindByName("Twin"), a)
		local twins = Scene.FindAllByName("Twin")
		Test.Expect(#twins == 2 and twins[1] == a and twins[2] == b, "both twins in order")
		Test.ExpectEqual(Scene.FindByTag("Searched"), a)
		local tagged = Scene.FindAllByTag("Searched")
		Test.Expect(#tagged == 2 and tagged[2] == b, "both tagged in order")
		Test.ExpectEqual(Scene.FindByPath("/SearchRoot/Twin[1]"), b)
		Test.ExpectEqual(Scene.FindByPath("/SearchRoot/Twin"), nil, "an ambiguous path is nil")
		Test.ExpectEqual(Scene.FindByPath("/Holder/Item"), Support.Find("Item"))
		local cameras = Scene.FindAllWithComponent("Camera")
		Test.Expect(#cameras == 1 and cameras[1] == Support.Find("Camera"), "one camera")
		local bodies = Scene.FindAllWithComponent("RigidBody")
		Test.Expect(#bodies >= 5, "the scene's bodies")
		Test.ExpectEqual(#Scene.FindAllByName("Missing"), 0)
		Test.ExpectEqual(#Scene.FindAllByTag("Missing"), 0)
		Test.Expect(not pcall(Scene.FindAllWithComponent, "NotAComponent"), "an unknown component is an error")
	end)

	Test.Case("Scene.Instantiate creates a prefab subtree under a parent at a pose", function()
		local parent = Scene.CreateEntity("Garage")
		local wheel = Scene.Instantiate(Assets.Load("Assets/Prefabs/Wheel.prefab") :: AssetRef, vector.create(1, 2, 3),
			Quat.FromEuler(0, 90, 0), parent)
		Test.ExpectEqual(wheel:GetParent(), parent)
		Test.ExpectEqual(wheel.Name, "Wheel")
		Test.ExpectEqual(#wheel:GetChildren(), 1)
		Test.ExpectNear(wheel.Transform.WorldPosition, vector.create(1, 2, 3), 0.0001)
		local loose = Scene.Instantiate(Assets.Load("Assets/Prefabs/Wheel.prefab") :: AssetRef)
		Test.ExpectEqual(loose:GetParent(), nil)
		Test.Expect(loose.ID ~= wheel.ID, "instances have their own ids")
	end)

	Test.Case("Scene.Destroy invalidates at once and removes at the next flush", function()
		local doomed = Scene.CreateEntity("SceneDoomed")
		local count = Scene.GetEntityCount()
		Scene.Destroy(doomed)
		Test.Expect(not doomed:IsValid(), "invalid at once")
		Test.ExpectEqual(Scene.FindByName("SceneDoomed"), nil, "searches never return a pending destruction")
		Test.ExpectEqual(Scene.GetEntityCount(), count - 1, "the count excludes it")
		Test.WaitTicks(1)
		Test.ExpectEqual(Scene.GetEntityCount(), count - 1)
	end)

	Test.Case("Scene.Load replaces the running scene at the end of the frame", function()
		Scene.CreateEntity("BeforeReload")
		Scene.Load(Assets.Load("Assets/Scenes/Scripting.scene") :: AssetRef, { Reloaded = true, Count = 2 })
		Test.Expect(Scene.FindByName("BeforeReload") ~= nil, "the scene lives until the frame ends")
	end)

	Test.Case("the reloaded scene starts fresh with the new parameters", function()
		Test.ExpectEqual(Scene.FindByName("BeforeReload"), nil)
		local parameters = Scene.GetLoadParameters()
		Test.ExpectEqual(parameters.Reloaded, true)
		Test.ExpectEqual(parameters.Count, 2)
		Test.ExpectEqual(Scene.GetName(), "Scripting")
	end)
end)
