--!strict
-- The Random module (§11.5): the session's seeded stream, which an independent generator with the same seed reproduces.
return Test.Suite("Api.Random", function()
	Test.Case("the session stream draws reproducibly after a seed", function()
		Random.Seed(1414)
		local integer = Random.Integer(-100, 100)
		local number = Random.Number()
		local ranged = Random.Number(-2, 3)
		local below = Random.Number(7)
		local coin = Random.Bool(0.3)
		local pick = Random.Choice({ "a", "b", "c" })
		local shuffled = Random.Shuffle({ 1, 2, 3, 4, 5, 6 })
		local direction = Random.UnitVector()
		local twin = Random.New(1414)
		Test.ExpectEqual(twin:Integer(-100, 100), integer)
		Test.ExpectEqual(twin:Number(), number)
		Test.ExpectEqual(twin:Number(-2, 3), ranged)
		Test.ExpectEqual(twin:Number(7), below)
		Test.ExpectEqual(twin:Bool(0.3), coin)
		Test.ExpectEqual(twin:Choice({ "a", "b", "c" }), pick)
		Test.ExpectEqual(table.concat(twin:Shuffle({ 1, 2, 3, 4, 5, 6 }), ","), table.concat(shuffled, ","))
		Test.ExpectEqual(twin:UnitVector(), direction)
		Test.Expect(integer >= -100 and integer <= 100, "an inclusive range")
		Test.Expect(number >= 0 and number < 1, "[0, 1)")
		Test.Expect(ranged >= -2 and ranged < 3, "[min, max)")
		Test.ExpectNear(vector.magnitude(direction), 1, 1e-6)
		table.sort(shuffled)
		Test.ExpectEqual(table.concat(shuffled, ","), "1,2,3,4,5,6", "a shuffle is a permutation")
		Test.Expect(not pcall(Random.Integer, 5, 1), "reversed bounds are refused")
	end)
end)
