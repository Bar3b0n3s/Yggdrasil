--!strict
-- The Math module (§11.5): scalar and vector interpolation, smoothing and angle helpers, and the constants.
return Test.Suite("Api.Math", function()
	Test.Case("scalar helpers clamp, interpolate, remap and wrap", function()
		Test.ExpectEqual(Math.Clamp(-10, -2, 5), -2)
		Test.ExpectEqual(Math.Clamp(20, -2, 5), 5)
		Test.ExpectEqual(Math.Clamp01(1.5), 1)
		Test.ExpectEqual(Math.Clamp01(-0.5), 0)
		Test.ExpectEqual(Math.Lerp(2, 6, 0.25), 3)
		Test.ExpectEqual(Math.Lerp(2, 6, 2), 6, "t is clamped")
		Test.ExpectEqual(Math.InverseLerp(2, 6, 3), 0.25)
		Test.ExpectEqual(Math.InverseLerp(6, 2, 3), 0.75)
		Test.ExpectEqual(Math.Remap(3, 2, 6, 10, 30), 15)
		Test.ExpectEqual(Math.SmoothStep(2, 6, 0.25), 2.625)
		Test.ExpectEqual(Math.MoveTowards(1, 5, 2), 3)
		Test.ExpectEqual(Math.MoveTowards(1, 2, 20), 2, "no overshoot")
		Test.Expect(Math.Approximately(1000000, 1000000.5), "relative tolerance")
		Test.Expect(not Math.Approximately(0, 0.01), "outside the tolerance")
		Test.ExpectEqual(Math.Sign(-3), -1)
		Test.ExpectEqual(Math.Sign(0), 0)
		Test.ExpectEqual(Math.Repeat(-7, 3), 2)
		Test.ExpectEqual(Math.PingPong(4, 3), 2)
		local value, velocity = Math.SmoothDamp(0, 1, 0, 2, 1)
		Test.ExpectNear(value, 0.26424111765711533, 1e-12)
		Test.ExpectNear(velocity, 0.36787944117144233, 1e-12)
		Test.Expect(not pcall(Math.Clamp, 1, 5, 2), "reversed bounds are an error")
	end)

	Test.Case("angle helpers take the shortest path in degrees", function()
		Test.ExpectEqual(Math.DeltaAngle(350, 10), 20)
		Test.ExpectEqual(Math.DeltaAngle(10, 350), -20)
		Test.ExpectEqual(Math.DeltaAngle(0, -180), 180)
		Test.ExpectEqual(Math.LerpAngle(350, 10, 0.5), 360)
		Test.ExpectNear(Math.Pi, math.pi, 2e-7)
		Test.ExpectNear(Math.Deg2Rad * 180, math.pi, 2e-7)
		Test.ExpectNear(Math.Rad2Deg * Math.Deg2Rad, 1, 2e-7)
	end)

	Test.Case("vector overloads work component-wise", function()
		local a, b = vector.create(-1, 2, 4), vector.create(1, 4, 8)
		Test.ExpectEqual(Math.Clamp(a, vector.zero, vector.create(2, 3, 3)), vector.create(0, 2, 3))
		Test.ExpectEqual(Math.Clamp01(a), vector.create(0, 1, 1))
		Test.ExpectEqual(Math.Lerp(a, b, 0.5), vector.create(0, 3, 6))
		Test.ExpectEqual(Math.MoveTowards(vector.zero, vector.create(3, 4, 0), 2.5), vector.create(1.5, 2, 0))
		local value, velocity = Math.SmoothDamp(vector.zero, vector.create(1, 2, -3), vector.zero, 2, 1)
		Test.ExpectNear(value, vector.create(0.26424111765711533, 0.5284822353142307, -0.792723352971346), 1e-6)
		Test.ExpectNear(velocity, vector.create(0.36787944117144233, 0.7357588823428847, -1.103638323514327), 1e-6)
	end)
end)
